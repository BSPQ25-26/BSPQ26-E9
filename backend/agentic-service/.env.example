# Copy this file to .env and fill in real values. Do not commit real credentials.

# LLM — required
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# Tavily web search — required for live market data in price recommendations
TAVILY_API_KEY=

# LangSmith tracing — optional but recommended for production observability
# Get your key at https://smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=false       # set to "true" to enable
LANGCHAIN_API_KEY=               # LangSmith API key
LANGCHAIN_PROJECT=wallabot       # project name shown in LangSmith dashboard

# Legacy LangSmith env var names (also supported; use one set or the other)
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=wallabot
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Test flags
RUN_LIVE_TESTS=false             # set to "true" to run tests that call real APIs
